# Copy this file to .env in the project root before running docker compose.
# docker-compose.yml reads these to configure MySQL + the backend container.

DB_NAME=hr_analytics
DB_USER=hr_app
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

SEED_EMPLOYEE_COUNT=420
DEFAULT_ADMIN_EMAIL=admin@hranalytics.io
DEFAULT_ADMIN_PASSWORD=Admin@12345
